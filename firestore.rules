rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isRealUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function ownsGroup(groupId) {
      return isRealUser()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    function isChatParticipant(chatId) {
      return isRealUser()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    function hasUserProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function validPublicProfile() {
      return request.resource.data.keys().hasAll(['memberId', 'fullName'])
        && request.resource.data.keys().hasOnly(['memberId', 'fullName'])
        && request.resource.data.memberId is string
        && request.resource.data.memberId.size() > 0
        && request.resource.data.memberId.size() <= 64
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120;
    }

    match /users/{userId} {
      allow read: if isRealUser();
      allow create, update: if isRealUser()
        && request.auth.uid == userId
        && validPublicProfile();
      allow delete: if isRealUser() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if isRealUser();

      allow create: if isRealUser()
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'memberIds'])
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'memberIds'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      allow update: if ownsGroup(groupId)
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'memberIds'])
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'memberIds'])
        && request.resource.data.ownerId == resource.data.ownerId
        && existsAfter(/databases/$(database)/documents/chats/$(groupId))
        && getAfter(/databases/$(database)/documents/chats/$(groupId)).data.participantIds == request.resource.data.memberIds
        && getAfter(/databases/$(database)/documents/chats/$(groupId)).data.name == request.resource.data.name
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() > 0
        && request.resource.data.memberIds.size() <= 200
        && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      allow delete: if false;

      match /joinRequests/{userId} {
        allow read: if isRealUser() && (request.auth.uid == userId || ownsGroup(groupId));

        allow create: if isRealUser()
          && request.auth.uid == userId
          && hasUserProfile(userId)
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && !(request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds)
          && request.resource.data.keys().hasAll(['userId', 'status', 'requestedAt'])
          && request.resource.data.keys().hasOnly(['userId', 'status', 'requestedAt'])
          && request.resource.data.userId == userId
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time;

        allow update: if ownsGroup(groupId)
          && request.resource.data.keys().hasAll(['userId', 'status', 'requestedAt'])
          && request.resource.data.keys().hasOnly(['userId', 'status', 'requestedAt'])
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.requestedAt == resource.data.requestedAt
          && (
            request.resource.data.status == 'rejected'
            || (
              request.resource.data.userId in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
              && request.resource.data.userId in getAfter(/databases/$(database)/documents/chats/$(groupId)).data.participantIds
            )
          );

        allow delete: if isRealUser()
          && (request.auth.uid == userId || ownsGroup(groupId));
      }
    }

    match /chats/{chatId} {
      allow read: if isChatParticipant(chatId);

      allow create: if isRealUser()
        && request.resource.data.keys().hasAll(['chatType', 'participantIds', 'createdAt'])
        && request.resource.data.keys().hasOnly(['chatType', 'participantIds', 'createdAt', 'groupId', 'name'])
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() >= 1
        && request.resource.data.participantIds.size() <= 200
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.chatType == 'direct'
            && request.resource.data.keys().hasOnly(['chatType', 'participantIds', 'createdAt'])
            && request.resource.data.participantIds.size() == 2
            && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
            && hasUserProfile(request.resource.data.participantIds[0])
            && hasUserProfile(request.resource.data.participantIds[1])
          )
          || (
            request.resource.data.chatType == 'group'
            && request.resource.data.keys().hasAll(['groupId', 'name'])
            && request.resource.data.groupId is string
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100
            && existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
            && request.resource.data.groupId == chatId
            && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid
            && request.resource.data.participantIds == getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds
          )
        );

      allow update: if isRealUser()
        && resource.data.chatType == 'group'
        && ownsGroup(resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'name'])
        && request.resource.data.participantIds == getAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds
        && request.resource.data.name == getAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.name
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId)
          && request.resource.data.keys().hasAll(['senderId', 'text', 'kind', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'kind', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.kind in ['text', 'q-query']
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    function isTenantMember(tenantId) {
      return isRealUser()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.active == true;
    }

    function isTenantAdmin(tenantId) {
      return isTenantMember(tenantId)
        && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function validTenantMember(tenantId, memberUid) {
      return request.resource.data.keys().hasAll(['tenantId', 'uid', 'role', 'displayName', 'employeeCode', 'active', 'createdAt'])
        && request.resource.data.keys().hasOnly(['tenantId', 'uid', 'role', 'displayName', 'employeeCode', 'active', 'createdAt'])
        && request.resource.data.tenantId == tenantId
        && request.resource.data.uid == memberUid
        && request.resource.data.role in ['admin', 'worker']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.employeeCode is string
        && request.resource.data.employeeCode.size() > 0
        && request.resource.data.employeeCode.size() <= 64
        && request.resource.data.active is bool;
    }

    match /tenants/{tenantId} {
      allow create: if isRealUser()
        && request.resource.data.keys().hasAll(['name', 'ownerUid', 'active', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'active', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.createdAt == request.time;
      // Tenant metadata is visible to an authenticated user with their own
      // Membership record, even when that Membership is disabled. Business
      // collections still require an active Membership and active tenant.
      allow read: if isRealUser()
        && resource.data.active == true
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
      allow update: if isTenantAdmin(tenantId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'active'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isRealUser()
          && (request.auth.uid == memberUid || isTenantAdmin(tenantId));
        allow create: if validTenantMember(tenantId, memberUid)
          && request.resource.data.active == true
          && request.resource.data.createdAt == request.time
          && (
            (
            isTenantAdmin(tenantId)
            && request.resource.data.role == 'worker'
          )
            || (
              isRealUser()
              && request.auth.uid == memberUid
              && request.resource.data.role == 'admin'
              && !exists(/databases/$(database)/documents/tenants/$(tenantId))
              && existsAfter(/databases/$(database)/documents/tenants/$(tenantId))
              && getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid
            )
          );
        allow update: if isTenantAdmin(tenantId)
          && validTenantMember(tenantId, memberUid)
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            request.resource.data.role == 'worker'
            || get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid
          );
        allow delete: if isTenantAdmin(tenantId) && memberUid != request.auth.uid;
      }

      // PIN credentials are server-only. Admin SDK bypasses Rules; no client may read or mutate them.
      match /employeeCredentials/{uid} {
        allow read, write: if false;
      }

      match /purchaseOrders/{poId} {
        allow read: if isTenantMember(tenantId);
        allow create: if isTenantAdmin(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.poCode is string
          && request.resource.data.totalQuantity is int
          && request.resource.data.totalQuantity > 0;
        allow update: if isTenantAdmin(tenantId)
          && resource.data.tenantId == tenantId
          && request.resource.data.tenantId == tenantId;
        allow delete: if isTenantAdmin(tenantId) && resource.data.tenantId == tenantId;
      }

      match /operationRates/{rateId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update: if isTenantAdmin(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.purchaseOrderId is string
          && existsAfter(/databases/$(database)/documents/tenants/$(tenantId)/purchaseOrders/$(request.resource.data.purchaseOrderId))
          && request.resource.data.operationId is string
          && request.resource.data.operationId.size() > 0
          && request.resource.data.operationName is string
          && request.resource.data.operationName.size() > 0
          && request.resource.data.unitRate is number
          && request.resource.data.unitRate >= 0;
        allow delete: if isTenantAdmin(tenantId) && resource.data.tenantId == tenantId;
      }

      match /productionEntries/{entryId} {
        allow read: if isTenantMember(tenantId)
          && resource.data.tenantId == tenantId
          && (isTenantAdmin(tenantId) || resource.data.workerUid == request.auth.uid);
        allow create: if isTenantMember(tenantId)
          && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'worker'
          && request.resource.data.tenantId == tenantId
          && request.resource.data.workerUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.quantity is int
          && request.resource.data.quantity > 0
          && request.resource.data.purchaseOrderId is string
          && exists(/databases/$(database)/documents/tenants/$(tenantId)/purchaseOrders/$(request.resource.data.purchaseOrderId))
          && get(/databases/$(database)/documents/tenants/$(tenantId)/purchaseOrders/$(request.resource.data.purchaseOrderId)).data.tenantId == tenantId;
        allow update: if isTenantAdmin(tenantId)
          && resource.data.tenantId == tenantId
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.workerUid == resource.data.workerUid
          && request.resource.data.quantity == resource.data.quantity
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid;
        allow delete: if false;
      }

      match /workerExtras/{extraId} {
        allow read: if isTenantMember(tenantId)
          && resource.data.tenantId == tenantId
          && (
            resource.data.workerUid == request.auth.uid
            || (isTenantAdmin(tenantId) && resource.data.status == 'pending')
          );
        allow create: if isTenantMember(tenantId)
          && get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.role == 'worker'
          && request.resource.data.tenantId == tenantId
          && request.resource.data.workerUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow update: if isTenantAdmin(tenantId)
          && resource.data.tenantId == tenantId
          && resource.data.status == 'pending'
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.workerUid == resource.data.workerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid;
        allow delete: if false;
      }

      match /earnings/{workerUid} {
        // Individual earnings are private to the worker; client-side Admin access is denied.
        allow read: if isTenantMember(tenantId) && request.auth.uid == workerUid;
        allow create, update, delete: if false;

        match /periods/{periodId} {
          allow read: if isTenantMember(tenantId) && request.auth.uid == workerUid
            && resource.data.tenantId == tenantId;
          allow create, update, delete: if false;
        }
      }

      match /settings/{settingId} {
        allow read: if isTenantMember(tenantId);
        allow create, update: if isTenantAdmin(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.submissionIntervalHours is number
          && request.resource.data.submissionIntervalHours >= 1
          && request.resource.data.submissionIntervalHours <= 3;
        allow delete: if false;
      }

      match /rooms/{roomId}/messages/{messageId} {
        allow read: if isTenantMember(tenantId) && resource.data.tenantId == tenantId;
        allow create: if isTenantMember(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
